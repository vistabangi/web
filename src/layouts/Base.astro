---
import '../styles/global.css';
import { Header } from '../components/Header';
import { Footer } from '../components/Footer';
import { Splash } from '../components/Splash';
import Seo from '../components/Seo.astro';
import { getDict, HTML_LANG, type Locale } from '../i18n';
import { resolveBrandAssets } from '../lib/assets';
import { SPONSOR } from '../data/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = getDict(locale);

// Resolved here (server-only, uses node:fs) and passed down as plain strings so
// the value never has to be recomputed inside a component.
const { logo } = resolveBrandAssets();

// Baked at build time — avoids shipping a script just to render a year.
const year = new Date().getFullYear();
---

<!doctype html>
<html lang={HTML_LANG[locale]} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#171410" />
    <Seo locale={locale} dict={dict} />
  </head>
  <body>
    <Splash logo={logo} sponsoredBy={dict.footer.sponsoredBy} sponsorName={SPONSOR.name} />

    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-100 focus:rounded-md focus:bg-white focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-ink-900 focus:shadow-lg"
    >
      {dict.nav.skipToContent}
    </a>

    <Header locale={locale} dict={dict} logo={logo} />

    <main id="main">
      <slot />
    </main>

    <Footer locale={locale} dict={dict} logo={logo} year={year} />
  </body>
</html>
