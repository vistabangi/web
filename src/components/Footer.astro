---
import { localeHref, LOCALES, LOCALE_NAMES, type Dict, type Locale } from '../i18n';
import { ADDRESS_LINE, BUILDING, CONTACT } from '../data/site';

interface Props {
  locale: Locale;
  dict: Dict;
  /** Build year, passed in so the value is baked at build time. */
  year: number;
}

const { locale, dict, year } = Astro.props;

const links = [
  { id: 'shops', label: dict.nav.shops },
  { id: 'residences', label: dict.nav.units },
  { id: 'facilities', label: dict.nav.facilities },
  { id: 'security', label: dict.nav.security },
  { id: 'location', label: dict.nav.location },
  { id: 'stay', label: dict.nav.stay },
  { id: 'contact', label: dict.nav.contact },
];
---

<footer class="mt-24 bg-ink-900 text-ink-100">
  <div class="shell grid gap-10 py-14 md:grid-cols-3">
    <div>
      <p class="font-display text-xl text-white">{BUILDING.name}</p>
      <p class="mt-1 text-sm text-ink-400">{dict.footer.tagline}</p>
      <address class="mt-4 text-sm leading-relaxed text-ink-200 not-italic">
        {ADDRESS_LINE}
      </address>
      {
        CONTACT.managementPhone && (
          <p class="mt-3 text-sm">
            <a class="hover:text-brass-300 underline decoration-ink-600 underline-offset-4" href={`tel:${CONTACT.managementPhone.replace(/\s/g, '')}`}>
              {CONTACT.managementPhone}
            </a>
          </p>
        )
      }
      {
        CONTACT.managementEmail && (
          <p class="text-sm">
            <a class="hover:text-brass-300 underline decoration-ink-600 underline-offset-4" href={`mailto:${CONTACT.managementEmail}`}>
              {CONTACT.managementEmail}
            </a>
          </p>
        )
      }
    </div>

    <nav aria-labelledby="footer-sections">
      <p id="footer-sections" class="text-xs font-semibold tracking-[0.16em] text-ink-400 uppercase">
        {dict.footer.sections}
      </p>
      <ul class="mt-4 grid grid-cols-2 gap-x-6 gap-y-2 text-sm">
        {
          links.map((l) => (
            <li>
              <a href={`#${l.id}`} class="hover:text-brass-300 transition-colors">
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav aria-labelledby="footer-lang">
      <p id="footer-lang" class="text-xs font-semibold tracking-[0.16em] text-ink-400 uppercase">
        {dict.nav.language}
      </p>
      <ul class="mt-4 grid gap-2 text-sm">
        {
          LOCALES.map((l) => (
            <li>
              <a
                href={localeHref(l)}
                hreflang={l}
                lang={l}
                aria-current={l === locale ? 'true' : undefined}
                class:list={['transition-colors', l === locale ? 'text-brass-300' : 'hover:text-brass-300']}
              >
                {LOCALE_NAMES[l]}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div class="border-t border-ink-800">
    <div class="shell flex flex-col gap-3 py-6 text-xs text-ink-400">
      <p>{dict.footer.rights(year)}</p>
      <p class="max-w-3xl leading-relaxed">{dict.footer.disclaimer}</p>
    </div>
  </div>
</footer>
