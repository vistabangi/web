---
import type { Dict } from '../i18n';
import { ADDRESS_LINE, HIGHWAYS, TRANSPORT } from '../data/site';
import {
  COPYABLE_ADDRESS,
  HAS_EXACT_PIN,
  MAP_DIRECTIONS_URL,
  MAP_EMBED_URL,
  MAP_PLACE_URL,
  WAZE_URL,
} from '../lib/maps';

interface Props {
  dict: Dict;
}

const { dict } = Astro.props;
---

<section
  id="location"
  class="scroll-mt-24 border-y border-ink-100 bg-white py-20"
  aria-labelledby="location-title"
>
  <div class="shell">
    <h2 id="location-title" class="section-title">{dict.location.title}</h2>
    <p class="prose-lead mt-4">{dict.location.intro}</p>

    <div class="mt-12 grid gap-10 lg:grid-cols-[1fr_1.15fr]">
      <div>
        <h3 class="text-xs font-semibold tracking-[0.16em] text-ink-400 uppercase">
          {dict.location.addressLabel}
        </h3>
        <address class="mt-3 text-lg leading-relaxed text-ink-900 not-italic">
          {ADDRESS_LINE}
        </address>

        <div class="mt-6 flex flex-wrap gap-3">
          <a
            href={MAP_DIRECTIONS_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-full bg-ink-900 px-5 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-ink-800"
          >
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M12 21s7-6.2 7-11a7 7 0 1 0-14 0c0 4.8 7 11 7 11Z" />
              <circle cx="12" cy="10" r="2.5" />
            </svg>
            {dict.location.directions}
          </a>

          <a
            href={MAP_PLACE_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-full border border-ink-200 px-5 py-2.5 text-sm font-semibold text-ink-700 transition-colors hover:border-ink-400"
          >
            {dict.location.openInMaps}
          </a>

          <a
            href={WAZE_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-full border border-ink-200 px-5 py-2.5 text-sm font-semibold text-ink-700 transition-colors hover:border-ink-400"
          >
            Waze
          </a>

          <button
            type="button"
            data-copy-address={COPYABLE_ADDRESS}
            data-copied-label={dict.location.copied}
            class="rounded-full border border-ink-200 px-5 py-2.5 text-sm font-semibold text-ink-700 transition-colors hover:border-ink-400"
          >
            {dict.location.copyAddress}
          </button>
        </div>

        {
          !HAS_EXACT_PIN && (
            <p class="mt-5 max-w-md text-xs leading-relaxed text-ink-400">
              {dict.location.pinNotice}
            </p>
          )
        }

        <div class="mt-10 grid gap-8 sm:grid-cols-2">
          <div>
            <h3 class="text-xs font-semibold tracking-[0.16em] text-ink-400 uppercase">
              {dict.location.nearbyTitle}
            </h3>
            <ul class="mt-3 grid gap-2 text-sm">
              {
                TRANSPORT.map((t) => (
                  <li class="flex justify-between gap-4 border-b border-ink-100 pb-2">
                    <span class="text-ink-700">{t.name}</span>
                    <span class="shrink-0 font-medium text-brass-600">
                      {dict.location.km(t.distanceKm)}
                    </span>
                  </li>
                ))
              }
            </ul>
          </div>

          <div>
            <h3 class="text-xs font-semibold tracking-[0.16em] text-ink-400 uppercase">
              {dict.location.highwaysTitle}
            </h3>
            <ul class="mt-3 flex flex-wrap gap-2">
              {
                HIGHWAYS.map((h) => (
                  <li class="rounded bg-sand-100 px-2.5 py-1 text-xs font-semibold tracking-wide text-ink-700">
                    {h}
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>

      <div class="overflow-hidden rounded-card border border-ink-100 bg-sand-100">
        <iframe
          src={MAP_EMBED_URL}
          title={dict.location.mapTitle}
          class="block h-[22rem] w-full border-0 lg:h-full lg:min-h-[30rem]"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen></iframe>
      </div>
    </div>
  </div>
</section>

<script>
  // Copy-to-clipboard for the address. Silently no-ops where the Clipboard API
  // is unavailable (e.g. non-secure contexts) — the address is still selectable.
  const button = document.querySelector<HTMLButtonElement>('[data-copy-address]');

  if (button && navigator.clipboard) {
    const original = button.textContent;
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copyAddress ?? '');
        button.textContent = button.dataset.copiedLabel ?? 'Copied';
        window.setTimeout(() => {
          button.textContent = original;
        }, 2000);
      } catch {
        /* Clipboard denied by the browser — leave the label untouched. */
      }
    });
  }
</script>
