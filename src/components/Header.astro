---
import LangSwitcher from './LangSwitcher.astro';
import { localeHref, type Dict, type Locale } from '../i18n';
import { BUILDING } from '../data/site';

interface Props {
  locale: Locale;
  dict: Dict;
}

const { locale, dict } = Astro.props;

const links = [
  { id: 'shops', label: dict.nav.shops },
  { id: 'residences', label: dict.nav.units },
  { id: 'facilities', label: dict.nav.facilities },
  { id: 'security', label: dict.nav.security },
  { id: 'location', label: dict.nav.location },
  { id: 'stay', label: dict.nav.stay },
  { id: 'contact', label: dict.nav.contact },
];
---

<header class="sticky top-0 z-50 border-b border-ink-800/70 bg-ink-900/95 backdrop-blur supports-[backdrop-filter]:bg-ink-900/80">
  <div class="shell flex h-16 items-center justify-between gap-4">
    <a href={localeHref(locale)} class="group flex items-baseline gap-2 text-white">
      <span class="font-display text-lg leading-none font-semibold tracking-tight">
        {BUILDING.shortName}
      </span>
      <span class="hidden text-[0.6875rem] tracking-[0.18em] text-ink-200 uppercase sm:inline">
        Service Apartment
      </span>
    </a>

    <nav aria-label={dict.nav.menu} class="hidden items-center gap-1 lg:flex">
      {
        links.map((l) => (
          <a
            href={`#${l.id}`}
            class="rounded-md px-2.5 py-2 text-sm text-ink-100 transition-colors hover:bg-ink-800 hover:text-white"
          >
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <LangSwitcher locale={locale} dict={dict} />
      <!-- Checkbox toggle: the mobile menu works with zero JavaScript. -->
      <input id="nav-toggle" type="checkbox" class="peer sr-only" />
      <label
        for="nav-toggle"
        class="cursor-pointer rounded-md p-2 text-ink-100 hover:bg-ink-800 hover:text-white lg:hidden"
        aria-label={dict.nav.menu}
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M3 6h18M3 12h18M3 18h18" stroke-linecap="round" />
        </svg>
      </label>

      <div
        class="absolute inset-x-0 top-16 hidden border-b border-ink-800 bg-ink-900 peer-checked:block lg:hidden!"
      >
        <nav aria-label={dict.nav.menu} class="shell grid gap-1 py-4">
          {
            links.map((l) => (
              <a
                href={`#${l.id}`}
                class="rounded-md px-3 py-2.5 text-base text-ink-100 hover:bg-ink-800 hover:text-white"
              >
                {l.label}
              </a>
            ))
          }
        </nav>
      </div>
    </div>
  </div>
</header>
