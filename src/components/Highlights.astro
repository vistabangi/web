---
import type { Dict } from '../i18n';

interface Props {
  dict: Dict;
}

const { dict } = Astro.props;
---

<section class="shell py-20" aria-labelledby="highlights-title">
  <h2 id="highlights-title" class="section-title">{dict.highlights.title}</h2>
  <p class="prose-lead mt-4">{dict.highlights.intro}</p>

  <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
    {
      dict.highlights.items.map((item, i) => (
        <li class="card p-6">
          <span
            class="font-display flex h-9 w-9 items-center justify-center rounded-full bg-ink-900 text-sm text-brass-300"
            aria-hidden="true"
          >
            {i + 1}
          </span>
          <h3 class="mt-4 text-base font-semibold text-ink-900">{item.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-ink-600">{item.body}</p>
        </li>
      ))
    }
  </ul>
</section>
