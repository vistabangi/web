---
import type { Dict } from '../i18n';
import { BUILDING } from '../data/site';

interface Props {
  dict: Dict;
}

const { dict } = Astro.props;

const stats = [
  { value: String(BUILDING.floors), label: dict.hero.statFloors },
  { value: String(BUILDING.blocks.length), label: dict.hero.statBlocks },
  { value: BUILDING.retailLevels.join(' & '), label: dict.hero.statRetail },
  { value: BUILDING.tenure, label: dict.hero.statTenure },
];
---

<section class="relative overflow-hidden bg-ink-900 text-white">
  <!-- Decorative tower silhouette; purely presentational. -->
  <div class="pointer-events-none absolute inset-0 opacity-[0.14]" aria-hidden="true">
    <svg width="100%" height="100%" preserveAspectRatio="xMidYMax slice" viewBox="0 0 800 400">
      <defs>
        <pattern id="win" width="16" height="22" patternUnits="userSpaceOnUse">
          <rect x="3" y="4" width="9" height="12" fill="currentColor" class="text-brass-300" />
        </pattern>
      </defs>
      <rect x="440" y="70" width="150" height="330" fill="url(#win)" />
      <rect x="610" y="120" width="150" height="280" fill="url(#win)" />
    </svg>
  </div>
  <div
    class="absolute inset-0 bg-gradient-to-tr from-ink-900 via-ink-900/85 to-ink-800/40"
    aria-hidden="true"
  >
  </div>

  <div class="shell relative py-20 md:py-28">
    <p class="text-xs font-semibold tracking-[0.2em] text-brass-300 uppercase">
      {dict.hero.eyebrow}
    </p>
    <h1
      class="font-display mt-5 max-w-3xl text-4xl leading-[1.08] font-semibold tracking-tight sm:text-5xl md:text-6xl"
    >
      {dict.hero.title}
    </h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-100">
      {dict.hero.subtitle}
    </p>

    <div class="mt-9 flex flex-wrap gap-3">
      <a
        href="#location"
        class="rounded-full bg-brass-400 px-6 py-3 text-sm font-semibold text-ink-900 transition-colors hover:bg-brass-300"
      >
        {dict.hero.ctaPrimary}
      </a>
      <a
        href="#shops"
        class="rounded-full border border-ink-400/60 px-6 py-3 text-sm font-semibold text-white transition-colors hover:border-brass-300 hover:text-brass-300"
      >
        {dict.hero.ctaSecondary}
      </a>
    </div>

    <dl class="mt-14 grid max-w-3xl grid-cols-2 gap-x-8 gap-y-6 sm:grid-cols-4">
      {
        stats.map((s) => (
          <div class="border-t border-ink-700 pt-3">
            <dd class="font-display text-2xl text-white sm:text-3xl">{s.value}</dd>
            <dt class="mt-1 text-xs leading-snug tracking-wide text-ink-400 uppercase">{s.label}</dt>
          </div>
        ))
      }
    </dl>
  </div>
</section>
