---
import type { Dict } from '../i18n';
import { BUILDING } from '../data/site';
import {
  activeCategories,
  ALL_TENANTS_PLACEHOLDER,
  tenantsByFloor,
  type TenantCategory,
} from '../data/tenants';

interface Props {
  dict: Dict;
}

const { dict } = Astro.props;
const categories = activeCategories();
const levels = BUILDING.retailLevels as readonly (1 | 2)[];

// Single-path icons, keyed by category. Stroked, 24×24 grid.
const ICONS: Record<TenantCategory, string> = {
  fnb: 'M4 3v6a4 4 0 0 0 8 0V3M8 13v8M16 3c-1.5 2-2 3.5-2 5.5S15 12 16 12s2-1.5 2-3.5S17.5 5 16 3ZM16 12v9',
  grocery: 'M4 5h2l2.2 10.2a2 2 0 0 0 2 1.6h7.4a2 2 0 0 0 2-1.5L21 8H7M10 21h.01M17 21h.01',
  health: 'M12 5v14M5 12h14',
  beauty: 'M12 3c2.5 3 4 5.5 4 8a4 4 0 0 1-8 0c0-2.5 1.5-5 4-8ZM12 15v6',
  services: 'M14.7 6.3a4 4 0 0 1 5 5L21 21l-4-1-9.3-9.3a4 4 0 0 1-1-5l3 3 2-2-3-3a4 4 0 0 1 5 1Z',
  retail: 'M3 7h18l-1.5 12.5a2 2 0 0 1-2 1.5H6.5a2 2 0 0 1-2-1.5L3 7ZM8 7V5a4 4 0 0 1 8 0v2',
  education: 'M3 9l9-5 9 5-9 5-9-5ZM7 11.5V17c0 1.5 2.2 3 5 3s5-1.5 5-3v-5.5',
  laundry: 'M4 3h16v18H4V3ZM8 7h.01M11 7h.01M12 17a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z',
};
---

<section id="shops" class="scroll-mt-24 border-y border-ink-100 bg-white py-20" aria-labelledby="shops-title">
  <div class="shell">
    <h2 id="shops-title" class="section-title">{dict.floors.title}</h2>
    <p class="prose-lead mt-4">{dict.floors.intro}</p>

    {
      ALL_TENANTS_PLACEHOLDER && (
        <p class="mt-6 flex max-w-3xl gap-3 rounded-lg border border-brass-300 bg-sand-100 p-4 text-sm leading-relaxed text-ink-700">
          <svg
            class="mt-0.5 shrink-0 text-brass-600"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="9" />
            <path d="M12 8h.01M12 11v5" stroke-linecap="round" />
          </svg>
          <span>{dict.floors.placeholderNotice}</span>
        </p>
      )
    }

    {/* Filter chips. Progressive enhancement: with JS off, everything stays visible. */}
    <div class="mt-10" data-shop-filter>
      <p class="text-xs font-semibold tracking-[0.16em] text-ink-400 uppercase">
        {dict.floors.filterLabel}
      </p>
      <div role="group" aria-label={dict.floors.filterLabel} class="mt-3 flex flex-wrap gap-2">
        <button
          type="button"
          data-filter="all"
          aria-pressed="true"
          class="rounded-full border border-ink-900 bg-ink-900 px-4 py-1.5 text-sm font-medium text-white transition-colors aria-pressed:border-ink-900 aria-pressed:bg-ink-900 aria-pressed:text-white"
        >
          {dict.floors.filterAll}
        </button>
        {
          categories.map((c) => (
            <button
              type="button"
              data-filter={c}
              aria-pressed="false"
              class="rounded-full border border-ink-200 bg-white px-4 py-1.5 text-sm font-medium text-ink-700 transition-colors hover:border-ink-400 aria-pressed:border-ink-900 aria-pressed:bg-ink-900 aria-pressed:text-white"
            >
              {dict.floors.categories[c]}
            </button>
          ))
        }
      </div>
    </div>

    <div class="mt-14 grid gap-14">
      {
        levels.map((floor) => {
          const tenants = tenantsByFloor(floor);
          return (
            <div data-level={floor}>
              <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1 border-b border-ink-100 pb-3">
                <h3 class="font-display text-2xl text-ink-900">{dict.floors.level(floor)}</h3>
                <p class="text-sm text-ink-600">{dict.floors.levelLead[floor]}</p>
              </div>

              <ul class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                {tenants.map((t) => (
                  <li
                    data-category={t.category}
                    class:list={[
                      'flex gap-4 rounded-card p-4 transition-colors',
                      t.placeholder
                        ? 'border border-dashed border-ink-200 bg-sand-50'
                        : 'card hover:border-ink-400',
                    ]}
                  >
                    <span
                      class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-ink-50 text-ink-600"
                      aria-hidden="true"
                    >
                      <svg
                        width="19"
                        height="19"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.7"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path d={ICONS[t.category]} />
                      </svg>
                    </span>

                    <div class="min-w-0">
                      <p class="font-semibold text-ink-900">{t.name}</p>
                      <p class="mt-0.5 text-xs tracking-wide text-ink-400 uppercase">
                        {dict.floors.categories[t.category]}
                        {t.unit && <span> · {dict.floors.unitLabel} {t.unit}</span>}
                      </p>

                      {t.hours && (
                        <p class="mt-2 text-sm text-ink-600">
                          {dict.floors.hoursLabel}: {t.hours}
                        </p>
                      )}
                      {t.phone && (
                        <p class="mt-1 text-sm">
                          <a
                            href={`tel:${t.phone.replace(/\s/g, '')}`}
                            class="font-medium text-ink-700 underline decoration-ink-200 underline-offset-4 hover:text-brass-600"
                          >
                            {dict.floors.callLabel} {t.phone}
                          </a>
                        </p>
                      )}
                      {t.placeholder && (
                        <p class="mt-2 inline-block rounded bg-sand-200 px-1.5 py-0.5 text-[0.6875rem] font-medium tracking-wide text-ink-600 uppercase">
                          {dict.floors.toBeConfirmed}
                        </p>
                      )}
                    </div>
                  </li>
                ))}
              </ul>

              <p data-empty hidden class="mt-6 text-sm text-ink-400">
                {dict.floors.emptyFiltered}
              </p>
            </div>
          );
        })
      }
    </div>
  </div>
</section>

<script>
  // Category filter for the shop directory. Kept tiny and dependency-free;
  // the markup is fully readable with this script absent.
  const root = document.querySelector<HTMLElement>('[data-shop-filter]');
  const buttons = root ? Array.from(root.querySelectorAll<HTMLButtonElement>('[data-filter]')) : [];
  const levels = Array.from(document.querySelectorAll<HTMLElement>('[data-level]'));

  function apply(active: string) {
    for (const button of buttons) {
      button.setAttribute('aria-pressed', String(button.dataset.filter === active));
    }

    for (const level of levels) {
      let visible = 0;
      for (const item of level.querySelectorAll<HTMLElement>('[data-category]')) {
        const show = active === 'all' || item.dataset.category === active;
        item.hidden = !show;
        if (show) visible++;
      }
      const empty = level.querySelector<HTMLElement>('[data-empty]');
      if (empty) empty.hidden = visible > 0;
    }
  }

  for (const button of buttons) {
    button.addEventListener('click', () => apply(button.dataset.filter ?? 'all'));
  }
</script>
