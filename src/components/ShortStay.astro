---
import type { Dict } from '../i18n';
import { SOCIAL } from '../data/site';

interface Props {
  dict: Dict;
}

const { dict } = Astro.props;
---

<section id="stay" class="shell scroll-mt-24 py-20" aria-labelledby="stay-title">
  <div class="rounded-card bg-ink-900 p-8 text-white md:p-12">
    <div class="grid gap-10 lg:grid-cols-2 lg:gap-16">
      <div>
        <p class="text-xs font-semibold tracking-[0.2em] text-brass-300 uppercase">Airbnb</p>
        <h2 id="stay-title" class="font-display mt-4 text-3xl leading-tight md:text-4xl">
          {dict.stay.title}
        </h2>
        <p class="mt-5 text-sm leading-relaxed text-ink-100">{dict.stay.intro}</p>

        {
          SOCIAL.airbnbSearch ? (
            <>
              <a
                href={SOCIAL.airbnbSearch}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-8 inline-block rounded-full bg-brass-400 px-6 py-3 text-sm font-semibold text-ink-900 transition-colors hover:bg-brass-300"
              >
                {dict.stay.cta}
              </a>
              <p class="mt-3 text-xs text-ink-400">{dict.stay.ctaNote}</p>
            </>
          ) : (
            /* No listing URL configured yet — show the note without a dead link. */
            <p class="mt-8 text-xs text-ink-400">{dict.stay.ctaNote}</p>
          )
        }
      </div>

      <ul class="grid content-start gap-3">
        {
          dict.stay.points.map((p) => (
            <li class="flex gap-3 border-b border-ink-800 pb-3 text-sm text-ink-100">
              <svg
                class="mt-0.5 shrink-0 text-brass-300"
                width="15"
                height="15"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M20 6 9 17l-5-5" />
              </svg>
              {p}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
