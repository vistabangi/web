---
import type { Dict } from '../i18n';
import { SECURITY } from '../data/site';

interface Props {
  dict: Dict;
}

const { dict } = Astro.props;

// Each card is gated on its flag in src/data/site.ts, so turning a feature off
// removes the claim from the page rather than leaving stale copy behind.
const cards = [
  {
    enabled: SECURITY.guarded24h,
    ...dict.security.guarded,
    icon: 'M12 3 4 6v6c0 5 3.4 8.3 8 9 4.6-.7 8-4 8-9V6l-8-3Z',
  },
  {
    enabled: SECURITY.cctv,
    ...dict.security.cctv,
    icon: 'M3 7l14-3 1.6 6L4.6 13 3 7ZM6 13v4a2 2 0 0 0 2 2h3M19 10l2.5-1v6L19 14',
  },
  {
    enabled: SECURITY.accessCardEntry,
    ...dict.security.access,
    icon: 'M3 6h18v12H3V6ZM7 10h5M7 13h3M16 10.5h2.5v3H16z',
  },
  {
    enabled: SECURITY.visitorRegistration,
    ...dict.security.visitor,
    icon: 'M9 11a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7ZM2.5 21a6.5 6.5 0 0 1 13 0M18 8v6M15 11h6',
  },
].filter((c) => c.enabled);
---

<section id="security" class="shell scroll-mt-24 py-20" aria-labelledby="security-title">
  <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
    <h2 id="security-title" class="section-title">{dict.security.title}</h2>
    {
      SECURITY.guarded24h && (
        <span class="rounded-full bg-ink-900 px-3 py-1 text-xs font-semibold tracking-wide text-brass-300 uppercase">
          24/7
        </span>
      )
    }
  </div>
  <p class="prose-lead mt-4">{dict.security.intro}</p>

  <ul class="mt-12 grid gap-6 sm:grid-cols-2">
    {
      cards.map((c) => (
        <li class="card flex gap-5 p-6">
          <span
            class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-ink-900 text-brass-300"
            aria-hidden="true"
          >
            <svg
              width="21"
              height="21"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d={c.icon} />
            </svg>
          </span>
          <div>
            <h3 class="text-base font-semibold text-ink-900">{c.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-600">{c.body}</p>
          </div>
        </li>
      ))
    }
  </ul>
</section>
